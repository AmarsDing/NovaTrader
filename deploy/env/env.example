# NovaTrader 44 部署环境变量（复制为 .env 后填写；chmod 600）
# cp env/env.example env/.env

# —— 凭据（必填）——
PG_USER=postgres
PG_PASSWORD=CHANGE_ME
PG_DB=novatrader

# —— 宿主端口避让（与 twinserver/hcf/aranea 共存）——
PG_PORT=5435
REDIS_PORT=6381
NATS_CLIENT_PORT=24222
NATS_HTTP_PORT=28222
ADMIN_HTTP_PORT=22001
ADMIN_WS_PORT=22003
WEB_PORT=9302

# —— 数据根（bind 到 /mnt/exdata，避免占满 /home）——
NT_DATA_ROOT=/mnt/exdata/novatrader/data

# —— 镜像 ——
PG_IMAGE=pgvector/pgvector:pg18
REDIS_IMAGE=redis:7
NATS_IMAGE=nats:2.10
GOLANG_IMAGE=golang:1.26
PYTHON_IMAGE=python:3.11-slim
ALPINE_IMAGE=alpine:latest
NGINX_IMAGE=nginx:1.28.1-alpine
NODE_IMAGE=node:20-bookworm
NT_APP_IMAGE=novatrader-app:runtime
NT_PYWORKER_IMAGE=novatrader-pyworker:runtime
NT_WEB_IMAGE=novatrader-web:runtime

# —— 镜像加速（不改 daemon.json）——
NT_MIRROR=docker.m.daocloud.io/library
# pgvector 走 docker.io 原路径时用：
NT_PGVECTOR_MIRROR=docker.m.daocloud.io/pgvector/pgvector:pg18

# —— pyworker ——
PYWORKER_ROLES=akshare,baostock
# 可选：Tushare token（datahub 源；留空则该源运行期取不到密钥）
# TUSHARE_TOKEN=

# —— nt-mcp 机器面（P3，:9303）——
# NTMCP_ENABLED=true 时进程才起；NT_MCP_TOKEN 为静态 Bearer（与 harness caller token、
# HCF AGT caller token 三分立，严禁复用）。改密=改此值+重启 nt-mcp（或改 ref 指向）。
NTMCP_ENABLED=false
NTMCP_PORT=9303
NT_MCP_TOKEN=

# —— 前端构建时注入的默认后端（SPA 仍可在登录页改）——
VITE_DEFAULT_HOST=192.168.4.44
VITE_DEFAULT_HTTP_PORT=22001
VITE_DEFAULT_WS_PORT=22003
