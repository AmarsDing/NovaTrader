    "dockview-core": "^8.4.1",
    "echarts": "^6.1.0",
    "lightweight-charts": "^4.2.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
