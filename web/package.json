{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && eslint . && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
